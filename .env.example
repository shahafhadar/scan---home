# Copy to .env.local for local dev. Set real values in Vercel, separately for
# Preview/Development (the dev Supabase project) and Production.

# Supabase project URL and anon (public) key: Project Settings -> API.
# Public by design: row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the device API (/api/v1/*), which bypasses RLS and
# checks each device's HMAC signature itself. On Vercel use the transaction
# pooler string (port 6543): Project Settings -> Database -> Connection string.
DATABASE_URL=

# Optional: the Supabase CA certificate (PEM), to verify the database TLS
# certificate instead of only encrypting.
# DATABASE_CA_CERT=

# Optional: look up unknown barcodes on Open Food Facts. Off by default.
# OPEN_FOOD_FACTS=true

# Tests only: an admin connection to a throwaway Postgres. Each test file
# creates its own database there. Without it, the database tests are skipped.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
